<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ez az a csomag, amit a felhasználók telepítenek: mag + latin modellek + CPU-s ONNX Runtime
       + a Skia natív könyvtárai Linuxra is. "Csak működjön" élmény, egyetlen PackageReference. -->
  <PropertyGroup>
    <PackageId>Tronnx.Ocr</PackageId>
    <RootNamespace>Tronnx.Ocr</RootNamespace>
    <Description>Fast, fully offline OCR for .NET on ONNX Runtime (PP-OCRv5). Cross-platform (Windows, Linux, macOS), no native OpenCV. Reads 32 Latin-script languages including Hungarian. Searchable PDF and highlighting coming in 2.0.</Description>
    <PackageTags>ocr;onnx;onnxruntime;offline-ocr;text-recognition;text-detection;paddleocr;pp-ocrv5;searchable-pdf;hungarian;magyar</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tronnx.Ocr.Core/Tronnx.Ocr.Core.csproj" />
    <ProjectReference Include="../Tronnx.Ocr.Models.Latin/Tronnx.Ocr.Models.Latin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.1" />
  </ItemGroup>

</Project>
